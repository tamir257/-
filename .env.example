# עותק את הקובץ הזה ל-.env.local ומלא את המפתח שלך.
# .env.local לא נכנס ל-git (ראה .gitignore).

# מפתח API של Anthropic, לצ'אט ה-AI. השג אחד ב-https://console.anthropic.com
ANTHROPIC_API_KEY=

# כתובת ה-IBKR Client Portal Gateway שרץ אצלך. השאר ריק לברירת המחדל
# (https://localhost:5000/v1/api) אלא אם הרצת אותו על פורט/כתובת אחרים.
IBKR_GATEWAY_URL=
